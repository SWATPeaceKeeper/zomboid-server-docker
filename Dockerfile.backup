# syntax=docker/dockerfile:1

# ---- rcon-cli ----------------------------------------------------------------
# Built from source for the same reason as in Dockerfile: the upstream release
# binary is from 2023 and carries the Go standard library of that time, including
# 41 HIGH/CRITICAL advisories that a newer base image cannot fix.
FROM golang:1.27-trixie@sha256:9baa6b4187bbb98d240372a8a235ac0bb6b5ddd52bba1431dc2f7c0705862728 AS rcon

ARG RCON_VERSION=v0.10.3
ENV CGO_ENABLED=0

RUN go install "github.com/gorcon/rcon-cli/cmd/gorcon@${RCON_VERSION}" \
  && install -m 0755 /go/bin/gorcon /usr/local/bin/rcon

# ---- runtime -----------------------------------------------------------------
FROM debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

LABEL org.opencontainers.image.title="Project Zomboid backup sidecar" \
  org.opencontainers.image.description="Scheduled world backups for a Project Zomboid dedicated server" \
  org.opencontainers.image.licenses="GPL-3.0-or-later" \
  org.opencontainers.image.source="https://github.com/SWATPeaceKeeper/zomboid-server-docker"

# hadolint ignore=DL3008
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  tzdata \
  zstd \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -g 1000 pz \
  && useradd -u 1000 -g 1000 -m -d /home/pz -s /bin/bash pz \
  && mkdir -p /data/backups /opt/pz \
  && chown -R pz:pz /data /opt/pz

COPY --from=rcon /usr/local/bin/rcon /usr/local/bin/rcon
COPY --chown=pz:pz scripts/lib/log.sh /opt/pz/scripts/lib/log.sh
COPY --chown=pz:pz scripts/backup/ /opt/pz/scripts/backup/

RUN chmod 0755 /opt/pz/scripts/backup/entrypoint.sh \
  /opt/pz/scripts/backup/backup-now.sh \
  && ln -s /opt/pz/scripts/backup/backup-now.sh /usr/local/bin/backup-now

ENV PZ_DATA_DIR=/data/zomboid \
  BACKUP_DIR=/data/backups \
  BACKUP_INTERVAL=6h \
  BACKUP_KEEP=14 \
  BACKUP_MODE=tar \
  BACKUP_ON_START=true \
  HOME=/home/pz

# Numeric, so a host or orchestrator can resolve the id without the image's
# passwd database.
USER 1000:1000
WORKDIR /data

ENTRYPOINT ["/opt/pz/scripts/backup/entrypoint.sh"]
