{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus that scrapes pz-exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Server up",
      "description": "1 when the server answered RCON on the last scrape. It goes to 0 for an outage, and the player panels go empty rather than to zero, so an outage cannot be mistaken for a quiet evening.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "down", "color": "red", "index": 0}}},
            {"type": "value", "options": {"1": {"text": "up", "color": "green", "index": 1}}}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "pz_up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Players online",
      "description": "Absent while the server is unreachable, rather than zero.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "text", "value": null}]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "pz_players_online",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Backup age",
      "description": "Time since the last backup that actually succeeded. A failed or skipped run does not move this, which is the point.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 5, "x": 8, "y": 0},
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 28800},
              {"color": "red", "value": 86400}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "time() - pz_backup_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Backup generations",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 4, "x": 13, "y": 0},
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "pz_backup_count",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Game build",
      "description": "The Steam build id currently installed. It changes when the server updates itself, which is the usual reason mods stop loading.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 7, "x": 17, "y": 0},
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "text", "value": null}]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "name"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "pz_server_info",
          "legendFormat": "{{build_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Players online",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": false},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "pz_players_online",
          "legendFormat": "players",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backup size",
      "description": "Size of the most recent archive. A sudden drop is worth looking at before the next restore does.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": false},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "pz_backup_last_size_bytes",
          "legendFormat": "archive",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Used against the ceiling, which is what answers whether PZ_MAX_RAM is too small. Empty unless PZ_JMX_METRICS=true on the server container. The metric is jvm_memory_used_bytes; the Prometheus Java client called it jvm_memory_bytes_used before 1.0.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["project-zomboid", "gameserver"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "",
  "title": "Project Zomboid",
  "uid": "pz-server",
  "version": 1,
  "weekStart": ""
}
