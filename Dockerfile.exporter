# syntax=docker/dockerfile:1

FROM golang:1.27-trixie@sha256:9baa6b4187bbb98d240372a8a235ac0bb6b5ddd52bba1431dc2f7c0705862728 AS build

WORKDIR /src
COPY exporter/go.mod exporter/go.sum ./
RUN go mod download
COPY exporter/ ./

ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags="-s -w" -o /out/pz-exporter .

# Nothing but the binary.
#
# This started on alpine, which was pleasant to debug and shipped an OpenSSL the
# exporter never calls: it speaks plain TCP to RCON and serves plain HTTP. Two
# HIGH advisories in that unused library blocked a release, and would have gone
# on doing so every few weeks. A base with no packages has no package
# vulnerabilities, which is a better answer than patching one forever.
#
# The trade is that there is no shell to exec into. The container's job is to
# answer /metrics, and whether it does is visible from outside it.
#
# The second trade only appears the day someone needs it: there is no CA bundle
# either. Nothing here speaks TLS — plain TCP to RCON, plain HTTP on /metrics —
# so the first outbound HTTPS call anyone adds fails with "x509: certificate
# signed by unknown authority", which reads like a broken CA store rather than an
# absent one, in a container with no shell to look around in. Adding such a call
# means adding the bundle with it:
#
#   COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
FROM scratch

LABEL org.opencontainers.image.title="Project Zomboid metrics exporter" \
  org.opencontainers.image.description="Prometheus metrics for a Project Zomboid server and its backups" \
  org.opencontainers.image.licenses="GPL-3.0-or-later" \
  org.opencontainers.image.source="https://github.com/SWATPeaceKeeper/zomboid-server-docker"

COPY --from=build /out/pz-exporter /pz-exporter

# Numeric because there is no passwd database to resolve a name against, which
# is exactly the point of this base.
USER 1000:1000
EXPOSE 9401

ENTRYPOINT ["/pz-exporter"]
